{
  "expo": {
    "name": "ReceitaNaMao",
    "slug": "ReceitaNaMao",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo.png",
    "scheme": "receitanamao",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.receitanamao.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "usesNonExemptEncryption": false
      },
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Permitir acesso ao reconhecimento de fala para buscar por voz",
        "NSMicrophoneUsageDescription": "Permitir acesso ao microfone para buscar por voz",
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.receitanamao.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/logo.png",
        "backgroundImage": "./src/assets/logo.png",
        "monochromeImage": "./src/assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir acesso às suas fotos",
          "cameraPermission": "Permitir acesso à câmera"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permitir acesso ao microfone para buscar por voz",
          "speechRecognitionPermission": "Permitir acesso ao reconhecimento de fala para buscar por voz",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f86baddc-a390-40ed-8a5e-e928f2df1df4"
      }
    },
    "owner": "anajgaspar",
    "updates": {
      "url": "https://u.expo.dev/f86baddc-a390-40ed-8a5e-e928f2df1df4"
    }
  }
}
